+type anykaPendingH264 struct {
+	codec *core.Codec
+	receiver *core.Receiver
+}
+
+// Publish headers on the DESCRIBE goroutine, rather than mutating a codec
+// asynchronously while it is being serialized into SDP.
+func (c *Conn) completeH264Bootstrap(limit time.Duration) {
+	if len(c.pendingH264) == 0 { return }
+	timer := time.NewTimer(limit)
+	defer timer.Stop()
+	defer func() { c.pendingH264 = nil }()
+	for _, pending := range c.pendingH264 {
+		select {
+		case <-pending.receiver.H264ParametersReady():
+			pending.codec.FmtpLine = pending.receiver.H264Fmtp()
+		case <-timer.C:
+			return
+		}
+	}
+}
